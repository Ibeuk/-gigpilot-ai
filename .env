# GigPilot AI — Development Environment Configuration
NODE_ENV=development
PORT=3001

# Database (PostgreSQL)
DATABASE_URL="postgresql://gigpilot:gigpilot_password@localhost:5432/gigpilot_ai?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication (JWT)
JWT_SECRET=dev-jwt-secret-key-gigpilot-ai-2026-super-secure-change-in-prod
JWT_REFRESH_SECRET=dev-refresh-secret-key-gigpilot-ai-2026-super-secure-change-in-prod
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AI Providers
AI_PRIMARY_PROVIDER=gemini
