# ─────────────────────────────────────────────────────
# GigPilot AI — Environment Configuration
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────────────

# ─── Application ────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database (PostgreSQL) ──────────────────────────
POSTGRES_USER=gigpilot
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=gigpilot_ai
POSTGRES_PORT=5432
DATABASE_URL=postgresql://gigpilot:your_secure_password_here@localhost:5432/gigpilot_ai?schema=public

# ─── Redis ──────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Authentication (JWT) ──────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_64_byte_hex_secret
JWT_REFRESH_SECRET=change_this_to_a_different_64_byte_hex_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Encryption (for stored API keys / OAuth tokens)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change_this_to_a_32_byte_hex_key

# ─── AI Providers ──────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AI_PRIMARY_PROVIDER=gemini
AI_MODEL_GEMINI=gemini-2.0-flash
AI_MODEL_OPENAI=gpt-4o-mini

# ─── Google Ads API ─────────────────────────────────
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REDIRECT_URI=http://localhost:3000/integrations/google-ads/callback

# ─── Meta Marketing API ────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/integrations/meta/callback

# ─── Google Analytics API ──────────────────────────
GA_CLIENT_ID=
GA_CLIENT_SECRET=
GA_REDIRECT_URI=http://localhost:3000/integrations/google-analytics/callback

# ─── Email Service ──────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=noreply@gigpilot.ai

# ─── Frontend ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# ─── Production (VPS) ─────────────────────────────
# PUBLIC_API_URL=https://api.yourdomain.com/api/v1
# PUBLIC_WS_URL=wss://api.yourdomain.com
# DOMAIN=yourdomain.com
# SSL_EMAIL=your@email.com
